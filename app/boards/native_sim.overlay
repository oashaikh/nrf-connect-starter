/* native_sim doesn't have GPIO pins; alias led0 to a soft "led" via the
 * gpio_emul controller so the build (and Twister) works without hardware. */
/ {
	aliases {
		led0 = &sim_led_0;
	};

	leds {
		compatible = "gpio-leds";
		sim_led_0: led_0 {
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
			label = "Sim LED";
		};
	};
};

&gpio0 {
	status = "okay";
};
